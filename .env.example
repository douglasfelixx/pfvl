# Vercel: use the Neon Postgres connection string for DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Used only by Drizzle schema commands when explicitly targeting Neon from this workspace.
NEON_DATABASE_URL=
VITE_SITE_URL=https://seu-dominio.com
# URL do sistema PFVL neste ambiente (configure um valor por ambiente no Vercel).
VITE_PFVL_APP_URL=
# URL pública de um MP4 de apresentação, por exemplo no R2; sem valor, exibe "em preparação".
VITE_PFVL_PRESENTATION_VIDEO_URL=

# Clerk do projeto PFVL. Configure as chaves de forma segura em cada ambiente.
CLERK_PUBLISHABLE_KEY=pk_test_substitua_pela_chave_do_clerk
CLERK_SECRET_KEY=
PFVL_ADMIN_EMAIL=admin@example.com

# Optional PFVL indicator API; leave unset to use clearly marked illustrative values.
PFVL_INDICATORS_API_URL=

# Cloudflare R2: bucket público por domínio HTTPS para imagens de conteúdo.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Optional comma-separated origins only when the browser app and API use different hosts.
PFVL_ALLOWED_ORIGINS=
